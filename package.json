{
  "name": "@countinghouse/ch-pack-ci-failure-triage",
  "version": "0.4.0",
  "description": "countinghouse scenario: one call answers \"why did CI fail?\" with the failing step, the error lines, the cross-run history and a measured receipt of what was read and what reached the model.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mchen6/ch-pack-ci-failure-triage.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "api.json",
    "schema.json",
    "handlers/",
    "lib/"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "validate": "node scripts/validate.js"
  },
  "countinghouse": {
    "role": "scenario",
    "calls": [
      "ch-access-github/githubService.listRuns",
      "ch-access-github/githubService.failedJobs",
      "ch-access-github/githubService.jobLog",
      "ch-access-github/githubService.runCommits",
      "ch-step-log-clean/cleanService.clean",
      "ch-step-error-patterns/patternService.extract",
      "ch-step-failure-signature/signatureService.sign",
      "ch-step-dedupe/dedupeService.group",
      "ch-step-owner-hint/ownerService.hint",
      "ch-step-redact/redactService.redact",
      "ch-step-report/reportService.assemble"
    ]
  },
  "devDependencies": {
    "@countinghouse/ch-step-log-clean": "file:test/fixtures/parts/countinghouse-ch-step-log-clean-0.2.0.tgz",
    "@countinghouse/ch-step-error-patterns": "file:test/fixtures/parts/countinghouse-ch-step-error-patterns-0.2.0.tgz",
    "@countinghouse/ch-step-failure-signature": "file:test/fixtures/parts/countinghouse-ch-step-failure-signature-0.2.0.tgz",
    "@countinghouse/ch-step-dedupe": "file:test/fixtures/parts/countinghouse-ch-step-dedupe-0.1.0.tgz",
    "@countinghouse/ch-step-owner-hint": "file:test/fixtures/parts/countinghouse-ch-step-owner-hint-0.1.0.tgz",
    "@countinghouse/ch-step-redact": "file:test/fixtures/parts/countinghouse-ch-step-redact-0.2.0.tgz",
    "@countinghouse/ch-step-report": "file:test/fixtures/parts/countinghouse-ch-step-report-0.4.0.tgz",
    "@countinghouse/ch-access-github": "file:test/fixtures/parts/countinghouse-ch-access-github-0.1.0.tgz",
    "countinghouse": "git+https://github.com/mchen6/countinghouse.git#9e1cdb591f470ea502f060ed70ce244bdab633fe"
  },
  "allowScripts": {
    "dtrace-provider": false,
    "msgpackr-extract": false,
    "sqlite3": false
  }
}
